{
  "project": {
    "name": "strumento-di-analisi-di-tutte-le-cartelle",
    "stack": ["python"],
    "exclude": ["node_modules", ".venv", "dist", "build", "__pycache__", "dossier-clienti", ".qa"]
  },
  "coverage": {
    "min_threshold": 70,
    "fail_below": false
  },
  "lint": {
    "python": { "enabled": true, "max_line_length": 100 },
    "typescript": { "enabled": false },
    "sql": { "enabled": false }
  },
  "security": { "enabled": false, "fail_on_high": true },
  "performance": { "enabled": false, "budget_ms": 200 },
  "a11y": { "enabled": false, "wcag_level": "AA" }
}
