# === SOA Platform — single entry configuration ===
# Frontend dev: Vite su :3000 fa proxy /api -> :8000 (python)
# Prod: python serve dist su :8000 (same origin, no CORS)
# Lascia vuoto per auto (proxy / same-origin). Override solo se backend su altro host/porta.
VITE_API_BASE=""

# Esempi:
# VITE_API_BASE=""                           # default: "" → /api via proxy (dev) o same-origin (prod)
# VITE_API_BASE="http://127.0.0.1:8000"      # backend locale esplicito
# VITE_API_BASE="http://192.168.1.10:8000"   # backend remoto

# Legacy (AI Studio, non usato qui):
# GEMINI_API_KEY="MY_GEMINI_API_KEY"
# APP_URL="MY_APP_URL"
