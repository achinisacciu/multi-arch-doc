<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:custom="http://example.com/custom"
             id="Defs_12" targetNamespace="http://example.com/unknown">
  <process id="Process_Unknown" name="Unknown">
    <startEvent id="Start_1"><outgoing>F1</outgoing></startEvent>
    <task id="Task_1" name="Known Task"><incoming>F1</incoming><outgoing>F2</outgoing></task>
    <!-- Unknown custom BPMN element -->
    <custom:myCustomTask id="Custom_1" name="Custom Vendor Task" customAttr="foo">
      <incoming>F2</incoming>
      <outgoing>F3</outgoing>
      <documentation>Vendor specific</documentation>
    </custom:myCustomTask>
    <unknownBpmnElement id="Weird_1" name="Weird"><incoming>F3</incoming><outgoing>F4</outgoing></unknownBpmnElement>
    <endEvent id="End_1"><incoming>F4</incoming></endEvent>
    <sequenceFlow id="F1" sourceRef="Start_1" targetRef="Task_1"/>
    <sequenceFlow id="F2" sourceRef="Task_1" targetRef="Custom_1"/>
    <sequenceFlow id="F3" sourceRef="Custom_1" targetRef="Weird_1"/>
    <sequenceFlow id="F4" sourceRef="Weird_1" targetRef="End_1"/>
  </process>
</definitions>
