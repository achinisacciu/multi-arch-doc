<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             id="Defs_2" targetNamespace="http://example.com/exclusive">
  <process id="Process_Exclusive" name="Exclusive Gateway" isExecutable="true">
    <startEvent id="Start_1" name="Start">
      <outgoing>F1</outgoing>
    </startEvent>
    <serviceTask id="Task_Service" name="Service Task">
      <incoming>F1</incoming>
      <outgoing>F2</outgoing>
    </serviceTask>
    <exclusiveGateway id="Gateway_1" name="Decision" default="F4">
      <incoming>F2</incoming>
      <outgoing>F3</outgoing>
      <outgoing>F4</outgoing>
    </exclusiveGateway>
    <task id="Task_B" name="Task B">
      <incoming>F3</incoming>
      <outgoing>F5</outgoing>
    </task>
    <task id="Task_C" name="Task C">
      <incoming>F4</incoming>
      <outgoing>F6</outgoing>
    </task>
    <endEvent id="End_1" name="End">
      <incoming>F5</incoming>
      <incoming>F6</incoming>
    </endEvent>
    <sequenceFlow id="F1" sourceRef="Start_1" targetRef="Task_Service"/>
    <sequenceFlow id="F2" sourceRef="Task_Service" targetRef="Gateway_1"/>
    <sequenceFlow id="F3" sourceRef="Gateway_1" targetRef="Task_B">
      <conditionExpression xsi:type="tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" language="http://www.w3.org/1999/XPath">${amount &gt; 100}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="F4" sourceRef="Gateway_1" targetRef="Task_C"/>
    <sequenceFlow id="F5" sourceRef="Task_B" targetRef="End_1"/>
    <sequenceFlow id="F6" sourceRef="Task_C" targetRef="End_1"/>
  </process>
</definitions>
