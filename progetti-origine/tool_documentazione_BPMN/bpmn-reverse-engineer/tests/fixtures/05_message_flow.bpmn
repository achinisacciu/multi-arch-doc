<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             id="Defs_5" targetNamespace="http://example.com/msg">
  <collaboration id="Collab_MSG">
    <participant id="Pool_Order" name="Order System" processRef="Process_Order"/>
    <participant id="Pool_Payment" name="Payment System" processRef="Process_Payment"/>
    <messageFlow id="MsgFlow_1" name="Payment Request" sourceRef="Pool_Order" targetRef="Pool_Payment"/>
    <messageFlow id="MsgFlow_2" name="Payment Confirm" sourceRef="Pool_Payment" targetRef="Pool_Order"/>
  </collaboration>
  <process id="Process_Order" name="Order Process">
    <startEvent id="Start_Order"><outgoing>F1</outgoing></startEvent>
    <sendTask id="Send_Payment" name="Send Payment"><incoming>F1</incoming><outgoing>F2</outgoing></sendTask>
    <endEvent id="End_Order"><incoming>F2</incoming></endEvent>
    <sequenceFlow id="F1" sourceRef="Start_Order" targetRef="Send_Payment"/>
    <sequenceFlow id="F2" sourceRef="Send_Payment" targetRef="End_Order"/>
  </process>
  <process id="Process_Payment" name="Payment Process">
    <startEvent id="Start_Pay"><outgoing>F3</outgoing></startEvent>
    <receiveTask id="Recv_Payment" name="Receive Payment"><incoming>F3</incoming><outgoing>F4</outgoing></receiveTask>
    <endEvent id="End_Pay"><incoming>F4</incoming></endEvent>
    <sequenceFlow id="F3" sourceRef="Start_Pay" targetRef="Recv_Payment"/>
    <sequenceFlow id="F4" sourceRef="Recv_Payment" targetRef="End_Pay"/>
  </process>
</definitions>
