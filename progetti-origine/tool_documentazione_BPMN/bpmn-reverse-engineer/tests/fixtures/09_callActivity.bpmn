<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:custom="http://example.com/custom"
             id="Defs_9" targetNamespace="http://example.com/call">
  <process id="Process_Main" name="Call Activity">
    <startEvent id="Start_1"><outgoing>F1</outgoing></startEvent>
    <callActivity id="Call_1" name="Call Subprocess" calledElement="SubProcess_External">
      <incoming>F1</incoming>
      <outgoing>F2</outgoing>
    </callActivity>
    <endEvent id="End_1"><incoming>F2</incoming></endEvent>
    <sequenceFlow id="F1" sourceRef="Start_1" targetRef="Call_1"/>
    <sequenceFlow id="F2" sourceRef="Call_1" targetRef="End_1"/>
  </process>
</definitions>
