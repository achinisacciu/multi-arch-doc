<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Defs_11" targetNamespace="http://example.com/cond">
  <process id="Process_Cond" name="Condition">
    <startEvent id="Start_1"><outgoing>F1</outgoing></startEvent>
    <exclusiveGateway id="GW_1"><incoming>F1</incoming><outgoing>F2</outgoing><outgoing>F3</outgoing></exclusiveGateway>
    <task id="Task_High" name="High Value"><incoming>F2</incoming><outgoing>F4</outgoing></task>
    <task id="Task_Low" name="Low Value"><incoming>F3</incoming><outgoing>F5</outgoing></task>
    <endEvent id="End_1"><incoming>F4</incoming><incoming>F5</incoming></endEvent>
    <sequenceFlow id="F1" sourceRef="Start_1" targetRef="GW_1"/>
    <sequenceFlow id="F2" sourceRef="GW_1" targetRef="Task_High">
      <conditionExpression language="http://www.w3.org/1999/XPath"><![CDATA[count($input) > 5 and $status = 'APPROVED']]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="F3" sourceRef="GW_1" targetRef="Task_Low">
      <conditionExpression language="bpmn:tFormalExpression">${low == true}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="F4" sourceRef="Task_High" targetRef="End_1"/>
    <sequenceFlow id="F5" sourceRef="Task_Low" targetRef="End_1"/>
  </process>
</definitions>
