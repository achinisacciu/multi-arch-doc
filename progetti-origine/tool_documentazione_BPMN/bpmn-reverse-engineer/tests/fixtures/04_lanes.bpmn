<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             id="Defs_4" targetNamespace="http://example.com/lanes">
  <collaboration id="Collab_1">
    <participant id="Participant_1" name="Pool A" processRef="Process_Lane"/>
  </collaboration>
  <process id="Process_Lane" name="Lane Process" isExecutable="true">
    <laneSet id="LaneSet_1">
      <lane id="Lane_1" name="Sales">
        <flowNodeRef>Start_1</flowNodeRef>
        <flowNodeRef>Task_A</flowNodeRef>
      </lane>
      <lane id="Lane_2" name="Finance">
        <flowNodeRef>Task_B</flowNodeRef>
        <flowNodeRef>End_1</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start_1" name="Start"><outgoing>F1</outgoing></startEvent>
    <userTask id="Task_A" name="Create Request"><incoming>F1</incoming><outgoing>F2</outgoing></userTask>
    <serviceTask id="Task_B" name="Process Payment"><incoming>F2</incoming><outgoing>F3</outgoing></serviceTask>
    <endEvent id="End_1" name="End"><incoming>F3</incoming></endEvent>
    <sequenceFlow id="F1" sourceRef="Start_1" targetRef="Task_A"/>
    <sequenceFlow id="F2" sourceRef="Task_A" targetRef="Task_B"/>
    <sequenceFlow id="F3" sourceRef="Task_B" targetRef="End_1"/>
  </process>
</definitions>
