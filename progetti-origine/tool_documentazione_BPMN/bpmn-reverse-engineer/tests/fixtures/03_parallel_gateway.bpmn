<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             id="Defs_3" targetNamespace="http://example.com/parallel">
  <process id="Process_Parallel" name="Parallel Gateway" isExecutable="true">
    <startEvent id="Start_1"><outgoing>F1</outgoing></startEvent>
    <parallelGateway id="Fork" name="Fork"><incoming>F1</incoming><outgoing>F2</outgoing><outgoing>F3</outgoing></parallelGateway>
    <serviceTask id="Task_1" name="Task 1"><incoming>F2</incoming><outgoing>F4</outgoing></serviceTask>
    <userTask id="UserTask_1" name="User Approve"><incoming>F3</incoming><outgoing>F5</outgoing></userTask>
    <parallelGateway id="Join" name="Join"><incoming>F4</incoming><incoming>F5</incoming><outgoing>F6</outgoing></parallelGateway>
    <endEvent id="End_1"><incoming>F6</incoming></endEvent>
    <sequenceFlow id="F1" sourceRef="Start_1" targetRef="Fork"/>
    <sequenceFlow id="F2" sourceRef="Fork" targetRef="Task_1"/>
    <sequenceFlow id="F3" sourceRef="Fork" targetRef="UserTask_1"/>
    <sequenceFlow id="F4" sourceRef="Task_1" targetRef="Join"/>
    <sequenceFlow id="F5" sourceRef="UserTask_1" targetRef="Join"/>
    <sequenceFlow id="F6" sourceRef="Join" targetRef="End_1"/>
  </process>
</definitions>
