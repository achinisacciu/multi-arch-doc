<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             id="Defs_6" targetNamespace="http://example.com/timer">
  <process id="Process_Timer" name="Timer Process">
    <startEvent id="Start_1" name="Start">
      <outgoing>F1</outgoing>
      <timerEventDefinition id="Timer_1">
        <timeDuration>PT5M</timeDuration>
      </timerEventDefinition>
    </startEvent>
    <intermediateCatchEvent id="Catch_Timer" name="Wait 5 min">
      <incoming>F1</incoming>
      <outgoing>F2</outgoing>
      <timerEventDefinition><timeCycle>R3/PT10H</timeCycle></timerEventDefinition>
    </intermediateCatchEvent>
    <task id="Task_A" name="Do Work"><incoming>F2</incoming><outgoing>F3</outgoing></task>
    <endEvent id="End_1"><incoming>F3</incoming></endEvent>
    <sequenceFlow id="F1" sourceRef="Start_1" targetRef="Catch_Timer"/>
    <sequenceFlow id="F2" sourceRef="Catch_Timer" targetRef="Task_A"/>
    <sequenceFlow id="F3" sourceRef="Task_A" targetRef="End_1"/>
  </process>
</definitions>
