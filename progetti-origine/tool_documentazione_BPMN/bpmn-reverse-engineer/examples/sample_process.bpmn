<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:ext="http://example.com/ext"
             id="DefsExample" targetNamespace="http://example.com/demo">
  <collaboration id="Collab_Demo">
    <participant id="Pool_Main" name="Main Pool" processRef="Process_Demo"/>
  </collaboration>
  <process id="Process_Demo" name="Demo Order Flow" isExecutable="true">
    <documentation>End-to-end demo covering most BPMN constructs</documentation>
    <laneSet>
      <lane id="Lane_Sales" name="Sales"><flowNodeRef>Start_1</flowNodeRef><flowNodeRef>Task_Approve</flowNodeRef></lane>
      <lane id="Lane_Backend" name="Backend"><flowNodeRef>Service_Pay</flowNodeRef><flowNodeRef>GW_Decision</flowNodeRef><flowNodeRef>End_1</flowNodeRef></lane>
    </laneSet>
    <startEvent id="Start_1" name="Order Received"><outgoing>F1</outgoing><messageEventDefinition/></startEvent>
    <userTask id="Task_Approve" name="Approve Order"><incoming>F1</incoming><outgoing>F2</outgoing></userTask>
    <serviceTask id="Service_Pay" name="Process Payment" implementation="##WebService">
      <incoming>F2</incoming><outgoing>F3</outgoing>
      <extensionElements><ext:adapter jca="PaymentAdapter" endpoint="http://example.com/pay"/></extensionElements>
    </serviceTask>
    <exclusiveGateway id="GW_Decision" name="Payment OK?" default="F5"><incoming>F3</incoming><outgoing>F4</outgoing><outgoing>F5</outgoing></exclusiveGateway>
    <scriptTask id="Task_Notify" name="Notify Success"><incoming>F4</incoming><outgoing>F6</outgoing></scriptTask>
    <callActivity id="Call_Fallback" name="Handle Failure" calledElement="FallbackProcess"><incoming>F5</incoming><outgoing>F7</outgoing></callActivity>
    <endEvent id="End_1" name="Done"><incoming>F6</incoming><incoming>F7</incoming></endEvent>
    <sequenceFlow id="F1" sourceRef="Start_1" targetRef="Task_Approve"/>
    <sequenceFlow id="F2" sourceRef="Task_Approve" targetRef="Service_Pay"/>
    <sequenceFlow id="F3" sourceRef="Service_Pay" targetRef="GW_Decision"/>
    <sequenceFlow id="F4" sourceRef="GW_Decision" targetRef="Task_Notify"><conditionExpression language="xpath"><![CDATA[$status='OK']]></conditionExpression></sequenceFlow>
    <sequenceFlow id="F5" sourceRef="GW_Decision" targetRef="Call_Fallback"/>
    <sequenceFlow id="F6" sourceRef="Task_Notify" targetRef="End_1"/>
    <sequenceFlow id="F7" sourceRef="Call_Fallback" targetRef="End_1"/>
  </process>
</definitions>
